generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("Agent")
  team         String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  ticketsCreated  Ticket[]      @relation("TicketCreatedBy")
  ticketsAssigned Ticket[]      @relation("TicketAssignedTo")
  passkeys        Passkey[]
  ticketEvents    TicketEvent[]
  attachments     Attachment[]
  notifications   Notification[]
}

model Passkey {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    String
  counter      Int      @default(0)
  deviceType   String?
  backedUp     Boolean  @default(false)
  transports   String?
  nickname     String?
  createdAt    DateTime @default(now())
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  company   String?
  notes     String?
  createdAt DateTime @default(now())

  tickets Ticket[]
}

model Team {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Vendor {
  id           Int      @id @default(autoincrement())
  name         String
  type         String   @default("Temporary")
  contactEmail String?
  contactPhone String?
  notes        String?
  createdAt    DateTime @default(now())

  tickets Ticket[]
}

model Ticket {
  id            Int      @id @default(autoincrement())
  ticketId      String   @unique
  customerName  String
  customerEmail String
  subject       String
  description   String
  status        String   @default("Open")
  priority      String   @default("Medium")
  team          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dueAt            DateTime?
  firstRespondedAt DateTime?
  resolvedAt       DateTime?
  reopenCount      Int       @default(0)
  nextAction       String?

  createdByUserId  Int
  createdByUser    User    @relation("TicketCreatedBy", fields: [createdByUserId], references: [id])
  assignedToUserId Int?
  assignedToUser   User?   @relation("TicketAssignedTo", fields: [assignedToUserId], references: [id])
  vendorId         Int?
  vendor           Vendor? @relation(fields: [vendorId], references: [id])
  contactId        Int?
  contact          Contact? @relation(fields: [contactId], references: [id])

  events        TicketEvent[]
  attachments   Attachment[]
  notifications Notification[]
}

model Attachment {
  id               Int      @id @default(autoincrement())
  ticketId         Int
  ticket           Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  storedFileName   String
  originalFileName String
  mimeType         String
  size             Int
  uploadedByUserId Int
  uploadedByUser   User     @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime @default(now())
}

// Singleton row (id is always 1) — org-wide branding and cosmetic label
// overrides for the fixed status/priority sets. The underlying status and
// priority *values* stay compile-time constants (SLA and state-machine logic
// depends on their exact literals); only their admin-facing display labels
// are configurable here.
model Settings {
  id             Int      @id @default(1)
  orgName        String   @default("Support CRM")
  supportEmail   String?
  accentColor    String   @default("#2563eb")
  statusLabels   String   @default("{}")
  priorityLabels String   @default("{}")

  sessionTimeoutMinutes Int @default(10080) // 7 days
  maxLoginAttempts      Int @default(5)
  lockoutMinutes        Int @default(15)

  updatedAt      DateTime @updatedAt
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  ticketId  Int?
  ticket    Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model RolePermission {
  id         Int    @id @default(autoincrement())
  role       String
  permission String

  @@unique([role, permission])
}

model SlaRule {
  id        Int      @id @default(autoincrement())
  priority  String   @unique
  hours     Int
  updatedAt DateTime @updatedAt
}

model Webhook {
  id        Int      @id @default(autoincrement())
  url       String
  secret    String
  events    String // JSON-encoded string[] of subscribed event names, or ["*"] for all
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id           Int      @id @default(autoincrement())
  webhookId    Int
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  eventType    String
  payload      String
  statusCode   Int?
  success      Boolean
  error        String?
  createdAt    DateTime @default(now())
}

model TicketEvent {
  id            Int      @id @default(autoincrement())
  ticketId      Int
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorUserId   Int?
  actor         User?    @relation(fields: [actorUserId], references: [id])
  type          String
  fromValue     String?
  toValue       String?
  message       String?
  createdAt     DateTime @default(now())
}
